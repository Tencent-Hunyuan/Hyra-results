      }
      for (int i = 0; i < h; i++) gmap[packed[i]] = -1;
      for (int t = 0; t < nkt; t++) kmask[kt[t]] = 0;
    }
    own_clear(c, h);
    if (res) s1_prunes++;
    return res;
  }

  // [port] returns 0 = no prune, 1 = packing > r, 2 = S0 (unit or GAC), 3 = S1, 4 = S2
  int csp_prune(const Code& c) {
    int r = cap - w;
    last_np = -1;
    if (r <= 0 || nA < r) return 0;
    csp_calls++;
    int np = -1;
    if (np < 0) {
    // greedy packing, same order as bound(), recording up to r + 1 packed generators
    uint16_t lst[AMAX], ord[AMAX];
    int hist[WMAX + 2];
    for (int i = 0; i <= c.W + 1; i++) hist[i] = 0;
#ifdef STABCERT_RULE_LIMIT
    int na0 = 0; if (nA > AMAX) STABCERT_RULE_LIMIT("greedy_amax");
#else
    int na0 = 0;
#endif
    for (int i = 0; i < (c.m + 31) / 32 && na0 < AMAX; i++) {
      uint32_t word = sb[i];
      while (word && na0 < AMAX) { int g = i * 32 + __builtin_ctz_hd(word); word &= word - 1; lst[na0++] = (uint16_t)g; hist[gcnt[g] + 1]++; }
    }
    for (int i = 1; i <= c.W + 1; i++) hist[i] += hist[i - 1];
    for (int i = 0; i < na0; i++) ord[hist[gcnt[lst[i]]]++] = lst[i];
    np = 0;
    for (int i = 0; i < na0 && np <= r; i++) {
      int g = ord[i], ok = 1;
      for (int p = 0; p < c.gw[g]; p++) { int q = c.gq[g * c.W + p]; if (cand(lab[q], c.gl[g * c.W + p]) && ((used[q >> 5] >> (q & 31)) & 1)) { ok = 0; break; } }
      if (!ok) continue;
      packed[np++] = (uint16_t)g;
      for (int p = 0; p < c.gw[g]; p++) { int q = c.gq[g * c.W + p]; if (cand(lab[q], c.gl[g * c.W + p])) used[q >> 5] |= 1u << (q & 31); }
    }
    for (int i = 0; i < (c.n + 31) / 32; i++) used[i] = 0;
    }
    if (np < r) { int m = mis_pack(c, r, np); if (m >= 0) np = m; }
    if (c.prune >= 3 && np == r - 2) return s2_extra(c, *this, np) ? 4 : 0;   // [port] S2 dispatch as in the reviewed S2 core c54147fb
    if (c.prune >= 2 && np == r - 1 && r >= 2) return s1_refute(c, np) ? 3 : 0;   // [port] S1 with S1MINR=2
    last_np = np;
    if (np < r) return 0;
    if (np > r) { csp_prunes++; return 1; }   // packing exceeds the budget: the same decision as bound()
    {
    int ur = unit_refute(c, r);
    if (ur) { csp_prunes++; csp_unit++; return 2; }
    }
    // choices x_i = (q, l): q in C_i, l in dom(q), l != g_i|q; flipped generators as local ids
    int nlg = 0, nch = 0, nfl = 0, res = -1;
    for (int i = 0; i < r && res < 0; i++) {
      int g = packed[i];
      vst[i] = (uint16_t)nch;
      for (int p = 0; p < c.gw[g] && res < 0; p++) {
        int q = c.gq[g * c.W + p], gl = c.gl[g * c.W + p], a = lab[q];
        if (!cand(a, gl)) continue;
        for (int l = 1; l <= 3 && res < 0; l++) {
          if (l == gl || (a > LFREE && a - LFREE != l)) continue;
#ifdef STABCERT_RULE_LIMIT
          if (nch >= CSP_MAXCH) { STABCERT_RULE_LIMIT("gac_maxch"); res = 0; break; }
#else
          if (nch >= CSP_MAXCH) { res = 0; break; }
#endif
          cvar[nch] = (uint8_t)i; cfs[nch] = (uint16_t)nfl;
          for (int j = 0; j < c.qc[q]; j++) {
            if (c.ql[q * c.C + j] == l) continue;
            int g2 = c.qg[q * c.C + j], lid = gmap[g2];
#ifdef STABCERT_RULE_LIMIT
            if (lid < 0) { if (nlg >= CSP_MAXLG) { STABCERT_RULE_LIMIT("gac_maxlg"); res = 0; break; } lid = gmap[g2] = (int16_t)nlg; lg[nlg] = (uint16_t)g2; tgt[nlg] = (uint8_t)sbit(g2); nlg++; }
#else
            if (lid < 0) { if (nlg >= CSP_MAXLG) { res = 0; break; } lid = gmap[g2] = (int16_t)nlg; lg[nlg] = (uint16_t)g2; tgt[nlg] = (uint8_t)sbit(g2); nlg++; }
#endif
#ifdef STABCERT_RULE_LIMIT
            if (nfl >= CSP_MAXOCC) { STABCERT_RULE_LIMIT("gac_maxocc"); res = 0; break; }
#else
            if (nfl >= CSP_MAXOCC) { res = 0; break; }
#endif
            cfl[nfl++] = (uint16_t)lid;
          }
          nch++;
        }
      }
    }
    if (res < 0) {
      vst[r] = (uint16_t)nch; cfs[nch] = (uint16_t)nfl;
      // an anticommuting generator that no choice flips cannot be fixed
      for (int i = 0; i < (c.m + 31) / 32 && res < 0; i++) {
        uint32_t word = sb[i];
        while (word) { int g = i * 32 + __builtin_ctz_hd(word); word &= word - 1; if (gmap[g] < 0) { res = 1; break; } }
      }
    }
    if (res < 0) {
      for (int g = 0; g <= nlg; g++) occs[g] = 0;
      for (int t = 0; t < nfl; t++) occs[cfl[t] + 1]++;
      for (int g = 0; g < nlg; g++) occs[g + 1] += occs[g];
      for (int ch = 0; ch < nch; ch++) for (int t = cfs[ch]; t < cfs[ch + 1]; t++) occ[occs[cfl[t]]++] = (uint16_t)ch;
      for (int g = nlg; g > 0; g--) occs[g] = occs[g - 1];
      occs[0] = 0;                                   // occ lists are grouped by var (choices are var-ordered)
      for (int ch = 0; ch < nch; ch++) alive[ch] = 1;
      for (int i = 0; i < r; i++) na[i] = (uint16_t)(vst[i + 1] - vst[i]);   // [port] matches widened na[]
      res = 0;
      for (int i = 0; i < r; i++) if (!na[i]) res = 1;
      int changed = 1;
      while (changed && !res) {
        changed = 0;
        for (int g = 0; g < nlg && !res; g++) {
          int par = 0, nmixed = 0, mv = -1;
          int k = occs[g], e = occs[g + 1];
          while (k < e) {
            int v = cvar[occ[k]], nf = 0;
            while (k < e && cvar[occ[k]] == v) { nf += alive[occ[k]]; k++; }
            if (!nf) continue;
            if (nf == na[v]) par ^= 1; else { if (++nmixed >= 2) break; mv = v; }
          }
          if (nmixed >= 2) continue;
          if (nmixed == 0) { if (par != tgt[g]) res = 1; continue; }
          int need = tgt[g] ^ par;
          for (int ch = vst[mv]; ch < vst[mv + 1]; ch++) {
            if (!alive[ch]) continue;
            int f = 0; for (int t = cfs[ch]; t < cfs[ch + 1]; t++) if (cfl[t] == g) { f = 1; break; }
            if (f != need) { alive[ch] = 0; na[mv]--; changed = 1; }
          }
          if (!na[mv]) res = 1;
        }
      }
    }
    for (int t = 0; t < nlg; t++) gmap[lg[t]] = -1;
    if (res > 0) csp_prunes++;
    return res > 0 ? 2 : 0;
  }
