# Copy to config/codex.env; keep credentials private and use valid shell syntax.
# The endpoint must support the Responses API. Do not append /responses.
CODEX_BACKEND=api
# CODEX_API_BASE_URL=https://api.example.com/v1
# HYPROVER_CODEX_API_KEY='replace-with-your-key'
CODEX_API_MODEL=gpt-6-astra

# Optional provider retry settings; omitted values use Codex defaults.
# CODEX_API_REQUEST_MAX_RETRIES=4
# CODEX_API_STREAM_MAX_RETRIES=4
# CODEX_API_STREAM_IDLE_TIMEOUT_MS=300000

# Optional Azure endpoint for one project's workers only.
# Replace DEMO with the project name uppercased, punctuation replaced by underscores.
# HYPROVER_PROJECT_DEMO_WORKER_API_PROVIDER=azure
# HYPROVER_PROJECT_DEMO_WORKER_API_BASE_URL=https://your-resource.openai.azure.com/openai
# HYPROVER_PROJECT_DEMO_WORKER_API_VERSION=your-api-version
# HYPROVER_PROJECT_DEMO_WORKER_API_KEY='replace-with-your-project-key'
