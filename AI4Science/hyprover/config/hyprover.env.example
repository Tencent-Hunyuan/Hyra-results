# Copy to config/hyprover.env. Later values override config/codex.env.
# Defaults: GPT 6 Astra, max reasoning, 8 workers (max:8) for new projects.
# Leave overrides commented to preserve backend settings.

# HYPROVER_MAIN_MODEL=gpt-6-astra
# HYPROVER_MAIN_EFFORT=max
# HYPROVER_WORKER_MODEL=gpt-6-astra
# HYPROVER_WORKER_EFFORT=max
# HYPROVER_VERIFY_MODEL=gpt-6-astra
# HYPROVER_VERIFY_EFFORT=max

# For Codex account login instead of an API key:
# CODEX_BACKEND=chatgpt

VERIFY_PORT=8091
DASHBOARD_PORT=8099

# Runtime defaults to this checkout's runtime/ directory.
# HYPROVER_RUNTIME=/absolute/path/to/runtime
# HYPROVER_AGENTS_ROOT=/absolute/path/to/projects
# VERIFIER_RESULTS_DIR=/absolute/path/to/verify-runs

# Worker limits; model usage is billable and these are not a monetary budget cap.
# HYPROVER_MAX_ROUNDS=0
# HYPROVER_ROUND_HARD_TIMEOUT=14400
# HYPROVER_MAX_CONSEC_FAILURES=5
# HYPROVER_RETRY_INTERVAL=30
# CODEX_TIMEOUT_SECONDS=900
# HYPROVER_VERIFY_TIMEOUT=3600
# HYPROVER_MCP_TOOL_TIMEOUT=3600

# HYPROVER_LITERATURE_SEARCH=0
